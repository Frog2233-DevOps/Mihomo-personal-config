# Line endings. The shell scripts and the lists run on the router (busybox ash):
# a CRLF in them ("sh\r") breaks the shebang and every command. A Windows
# checkout must not turn them into CRLF.
*.sh    text eol=lf
*.init  text eol=lf
*.py    text eol=lf
*.list  text eol=lf
*.conf  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf

# PowerShell is the one script that runs on Windows only - CRLF is its habit.
*.ps1   text eol=crlf

# Compiled rule-sets are binary.
*.mrs   binary
