#!/bin/sh /etc/rc.common
# =============================================================================
#  mixomo-ipv6 - keep the IPv6 of the tunnel device of the scheme alive
# =============================================================================
#  The tunnel device "Mihomo" comes up with IPv6 disabled when the router
#  has IPv6 switched off. MagiTrickle adds a default route for that device,
#  the kernel refuses it, and the daemon dies at once:
#
#      failed to enable group: failed to link ipset to interface:
#      error adding iface route: permission denied
#
#  This service runs scripts/mixomo-ipv6.sh: it waits for the device, enables
#  IPv6 on this one device (never globally) and starts MagiTrickle again.
#  The device is created again at every start of the tunnel, so the state is
#  checked and repaired.
#
#  The order at the boot matters: the tunnel (hev-socks5-tunnel, START=99)
#  has to create the device before the guard repairs it. The guard waits for
#  the device anyway, so a race at the start cannot break it.
#
#  Commands:
#      service mixomo-ipv6 start|stop|restart|status
#      service mixomo-ipv6 fix      - the fix, once
#      service mixomo-ipv6 report   - the state of the device and of the
#                                     service (the same as status)
#
#  The fix is switched off with FIX_IPV6=0 in /etc/mihomo/mixomo.conf.
# =============================================================================
# The values are read by /etc/rc.common, not by this file.
# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

extra_command "fix" "Enable IPv6 on the tunnel device, once"
extra_command "report" "Show the state of the tunnel device and of MagiTrickle"

GUARD="/etc/mihomo/scripts/mixomo-ipv6.sh"

start_service() {
	procd_open_instance ipv6
	procd_set_param command /bin/sh "$GUARD" guard
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

report() {
	[ -f "$GUARD" ] || {
		echo "$GUARD is missing"
		return 1
	}
	sh "$GUARD" status
}

fix() {
	[ -f "$GUARD" ] || {
		echo "$GUARD is missing"
		return 1
	}
	sh "$GUARD" fix
}

# The status of the service is the report of the script: the device, the
# value of the knob and the state of MagiTrickle.
status_service() {
	report
}
